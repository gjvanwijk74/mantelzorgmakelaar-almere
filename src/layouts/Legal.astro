---
import GoogleTag from '../components/GoogleTag.astro';
import CookieBar from '../components/CookieBar.astro';
// Self-hosted fonts (no requests to Google Fonts)
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/600.css';
import '@fontsource/nunito/800.css';
interface Props { title: string; description: string; path: string; }
const { title, description, path } = Astro.props;
const url = `https://mantelzorgmakelaar-almere.nl${path}`;
---
<!doctype html>
<html lang="nl">
<head>
<GoogleTag />
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title} | Mantelzorgmakelaar Almere</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#6B5A8E">
<style is:global>
body{margin:0}
a{color:#6B5A8E}a:hover{color:#4E4070}
.legal h1{margin:0 0 8px;font-weight:800;font-size:42px;line-height:1.2}
.legal h2{margin:48px 0 12px;font-weight:800;font-size:26px;line-height:1.3}
.legal h3{margin:28px 0 8px;font-weight:800;font-size:20px}
.legal p,.legal ul{margin:0 0 16px}
.legal ul{padding-left:22px}
.legal li{margin-bottom:6px}
.legal table{width:100%;border-collapse:collapse;margin:0 0 16px;font-size:16px}
.legal th,.legal td{text-align:left;vertical-align:top;padding:10px 12px;border-bottom:1px solid #E4DCEB}
.legal th{background:#E9E3F5}
.legal .meta{color:#5E5670;font-size:16px;margin-bottom:32px}
@media (max-width: 640px) { .legal h1 { font-size: 32px; } .legal table { font-size: 14px; } }
</style>
</head>
<body>
<div style="font-family: Nunito, system-ui, sans-serif; color: #3A3150; background: #FFFBF8; font-size: 18px; line-height: 1.7; min-height: 100vh">
<header>
<nav style="max-width: 1200px; margin: 0 auto; padding: 24px 32px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px">
<a href="/" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: #3A3150">
<svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#6B5A8E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path></svg>
<span style="display: flex; flex-direction: column; line-height: 1.2"><span style="font-weight: 800; font-size: 21px">Mantelzorgmakelaar Almere</span><span style="font-size: 14px; color: #5E5670">De digitale keukentafel voor mantelzorgers</span></span></a>
<a href="/#contact" style="background: #6B5A8E; color: #FFFFFF; padding: 12px 22px; border-radius: 999px; text-decoration: none; font-weight: 800; font-size: 16px">Gratis kennismaking</a>
</nav>
</header>
<main class="legal" style="max-width: 820px; margin: 0 auto; padding: 32px 32px 80px">
<slot />
</main>
<footer style="background: #DCE9F5">
<div style="max-width: 1200px; margin: 0 auto; padding: 32px; font-size: 15px; color: #5E5670">Montana BV · Birgitta Naafs · Veerkade 88, Almere Haven · KvK-nummer volgt<br><a href="/">Home</a> · <a href="/privacyverklaring/">Privacyverklaring</a> · <a href="/cookiebeleid/">Cookiebeleid</a> · <button type="button" data-cookie-instellingen style="background: none; border: 0; padding: 0; font: inherit; color: #6B5A8E; text-decoration: underline; cursor: pointer">Cookie-instellingen</button></div>
</footer>
</div>
<CookieBar />
</body>
</html>
