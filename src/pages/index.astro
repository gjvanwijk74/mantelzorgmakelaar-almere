<div><p style="margin: 0 0 8px; font-weight: 800; font-size: 40px; line-height: 1.1">Mantelzorg</p><p style="margin: 0 0 8px; font-weight: 800; font-size: 19px; color: #6B5A8E">in 40 stappen</p><p style="margin: 0; font-size: 15px">Birgitta Naafs</p></div>
