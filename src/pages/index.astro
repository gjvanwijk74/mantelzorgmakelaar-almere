<div style="max-width: 1200px; margin: 0 auto; padding: 0 32px 40px; font-size: 15px; color: #5E5670">Montana BV · Birgitta Naafs · Veerkade 88, Almere Haven · KvK-nummer volgt</div>
</footer>


</div>
<script>
for (const form of document.querySelectorAll('form[action^="/api/"]')) {
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector('[data-status]') || form.parentElement.querySelector('[data-status]');
    const btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    status.textContent = 'Bezig met versturen...';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const out = await res.json().catch(() => ({}));
      if (res.ok && out.ok) {
        form.reset();
        status.textContent = form.id === 'form-gids'
          ? 'Dank je. Je hoort het zodra de gids verschijnt.'
          : 'Dank je. Je aanvraag is binnen, ik neem contact met je op om een moment te kiezen.';
      } else {
        status.textContent = 'Er ging iets mis. Probeer het nog eens of mail naar info@mantelzorgmakelaar-almere.nl.';
      }
    } catch {
      status.textContent = 'Er ging iets mis. Probeer het nog eens of mail naar info@mantelzorgmakelaar-almere.nl.';
    }
    btn.disabled = false;
  });
}
</script>
