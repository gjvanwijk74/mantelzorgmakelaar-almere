<div style="flex: 0 1 300px; height: 400px; background: #E9E3F5; border-radius: 20px; padding: 36px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 20px 40px rgba(58,49,80,0.12)">
