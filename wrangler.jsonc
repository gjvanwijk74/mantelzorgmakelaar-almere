{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mantelzorgmakelaar-almere",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "mantelzorgmakelaar-almere.nl", "custom_domain": true },
    { "pattern": "www.mantelzorgmakelaar-almere.nl", "custom_domain": true }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "CANONICAL_HOST": "mantelzorgmakelaar-almere.nl",
    "MAIL_FROM": "aanvraag@mantelzorgmakelaar-almere.nl"
  },
  // MAIL_TO and MAIL_CC are set as variables in the Cloudflare dashboard,
  // so recipient addresses stay out of this public repo.
  "keep_vars": true
}
